// =============================================================
// Cloudora Executive Account Takeover — Investigation Queries
// Report ID: CLD-IR-0001
// Source: Microsoft Sentinel / Azure Data Explorer (KQL)
// =============================================================

// -------------------------------------------------------------
// 1. Full sign-in timeline for the compromised CEO account
// Purpose: Establish a chronological record of all sign-in activity for daniel.reeve on the day of compromise, to identify the malicious session and confirm impossible travel.
// -------------------------------------------------------------
CloudoraSignIn_CL
| where UserPrincipalName == "daniel.reeve@cloudora.io"
| where TimeGenerated between (datetime(2026-08-10) .. datetime(2026-08-11))
| project TimeGenerated, AppDisplayName, IPAddress, City, Country, ResultType, ResultDescription
| order by TimeGenerated asc


// -------------------------------------------------------------
// 2. Sign-in locations/devices summary for the CEO account
// Purpose: Baseline normal sign-in geography (London) against the anomalous Lagos, Nigeria sign-in to support Finding 1 (account takeover, not travel).
// -------------------------------------------------------------
CloudoraSignIn_CL
| where UserPrincipalName == "daniel.reeve@cloudora.io"
| summarize SignIns=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated) by Country, City, IPAddress
| order by SignIns desc


// -------------------------------------------------------------
// 3. Sign-in locations/devices summary for omar.farah
// Purpose: Validate Finding 6 — confirm Dubai sign-ins are consistent legitimate travel (same device, business hours) rather than compromise, to rule out a false positive.
// -------------------------------------------------------------
CloudoraSignIn_CL
| where UserPrincipalName == "omar.farah@cloudora.io"
| summarize SignIns=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated) by Country, City, IPAddress
| order by SignIns desc


// -------------------------------------------------------------
// 4. Failed sign-ins by source IP (password spray detection)
// Purpose: Identify low-volume, high-breadth failed login attempts (ResultType 50126 = invalid credentials) across many accounts from the same IP — the signature of password spraying, supporting Finding 2.
// -------------------------------------------------------------
CloudoraSignIn_CL
| where ResultType == "50126"
| summarize Failures=count(), TargetedAccounts=dcount(UserPrincipalName) by IPAddress, Country
| order by Failures desc


// -------------------------------------------------------------
// 5. Daily attempt volume from attacker-controlled IP range
// Purpose: Show the night-by-night pattern (Aug 8–10) of attempts from the 102.89.x.x range, confirming the spray was paced to avoid lockout thresholds.
// -------------------------------------------------------------
CloudoraSignIn_CL
| where IPAddress startswith "102.89."
| summarize Attempts=count() by bin(TimeGenerated, 1d), ResultType


// -------------------------------------------------------------
// 6. Audit activity from attacker IP range
// Purpose: Surface post-compromise actions taken by the attacker (e.g., MFA device registration, inbox rule creation) to support Findings 3 and 4.
// -------------------------------------------------------------
CloudoraAudit_CL
| where IPAddress startswith "102.89."
| project TimeGenerated, ActivityDisplayName, TargetUser, Details
| order by TimeGenerated asc


// -------------------------------------------------------------
// 7. Successful sign-ins from attacker IP range
// Purpose: Identify every account actually breached (not just targeted) by the 102.89.x.x range, to confirm full scope of compromise (daniel.reeve and priya.nair).
// -------------------------------------------------------------
CloudoraSignIn_CL
| where IPAddress startswith "102.89." and ResultType == "0"
| summarize by UserPrincipalName, IPAddress, TimeGenerated
| order by TimeGenerated asc
